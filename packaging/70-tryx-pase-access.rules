# Supported TRYX displays expose a vendor protocol over a USB Printer Class
# interface. Mark them for logind ACL assignment before 73-seat-late.rules.
# Match every event except remove: logind grants the seat ACL at login only to
# devices whose latest event kept the uaccess tag, and the kernel's bind event
# follows add.

ACTION!="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="391a", ATTR{idProduct}=="1021", OWNER="root", GROUP="lp", MODE="0660", TAG+="uaccess"

ACTION!="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="391a", ATTR{idProduct}=="1011", OWNER="root", GROUP="lp", MODE="0660", TAG+="uaccess"

ACTION!="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="391a", ATTR{idProduct}=="1031", OWNER="root", GROUP="lp", MODE="0660", TAG+="uaccess"

ACTION!="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="391a", ATTR{idProduct}=="2011", OWNER="root", GROUP="lp", MODE="0660", TAG+="uaccess"
