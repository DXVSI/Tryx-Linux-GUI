#!/bin/sh
set -e

#DEBHELPER#

case "$1" in
    remove|purge)
        if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
            deb-systemd-invoke --user --no-dbus daemon-reload \
                >/dev/null 2>&1 || true
        fi
        if [ -z "${DPKG_ROOT:-}" ] && command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
